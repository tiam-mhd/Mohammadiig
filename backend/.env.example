# Local development (SQLite)
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DB_DRIVER=sqlite
DATABASE_PATH=./data/mig.sqlite

# Bootstrap admin (created automatically on API startup if missing)
ADMIN_EMAIL=admin@mohammadiig.ir
ADMIN_PASSWORD=MigAdmin2026!
ADMIN_FIRST_NAME=MIG
ADMIN_LAST_NAME=Admin

# --- Production / ParsPack PaaS (Node.js app) ---
# Context directory: backend
# Build: npm install && npm run build
# Start: npm start
#
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# FRONTEND_URL=https://mohammadiig.ir,https://www.mohammadiig.ir
# JWT_SECRET=use-a-unique-random-secret-at-least-32-characters
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/mig
# ADMIN_EMAIL=admin@mohammadiig.ir
# ADMIN_PASSWORD=change-me-to-a-strong-password
# ADMIN_FIRST_NAME=MIG
# ADMIN_LAST_NAME=Admin
#
# Important: if DATABASE_URL is set, the app uses Postgres and runs migrations on boot.
# If only SQLite defaults are used, your Postgres service stays empty (no users table).

# Media library (WordPress-style). Keep MEDIA_ROOT on a persistent disk/volume so redeploys do not wipe uploads.
MEDIA_ROOT=./data/media
# Optional absolute public base for image URLs (recommended in production):
# MEDIA_PUBLIC_BASE_URL=https://api.mohammadiig.ir
