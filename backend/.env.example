# تنظیمات توسعه؛ این فایل حاوی کلید یا رمز عملیاتی نیست.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
DB_DRIVER=sqlite
DATABASE_PATH=./data/mig.sqlite
# فقط در توسعه، نبود JWT_SECRET و اطلاعات مدیر از مقدار توسعه استفاده می‌کند.
# برای محیط عملیاتی، کلید تصادفی مستقل با حداقل ۳۲ نویسه و رمز مدیر حداقل ۱۲ نویسه تنظیم کنید.
# JWT_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
ADMIN_FIRST_NAME=مدیر
ADMIN_LAST_NAME=سامانه

# محیط عملیاتی: همه موارد زیر باید در مدیریت اسرار سرویس میزبانی تنظیم شوند.
# NODE_ENV=production
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# FRONTEND_URL=https://mohammadiig.ir,https://www.mohammadiig.ir
# فقط مبدأهای دقیق HTTPS مجازند؛ مسیر، wildcard و HTTP مجاز نیستند.
# نبود JWT_SECRET، ADMIN_EMAIL، ADMIN_PASSWORD، DATABASE_URL یا کلید پیامک مانع اجرا است.
# Migrationهای موجود هنگام شروع اجرا می‌شوند؛ پیش از استقرار از دیتابیس پشتیبان بگیرید.

# مسیر رسانه باید روی دیسک پایدار باشد. خالی بودن مبدأ عمومی یعنی استفاده از مسیر نسبی.
MEDIA_ROOT=./data/media
MEDIA_PUBLIC_BASE_URL=

# کلید پیامک را فقط در محیط اجرا تنظیم کنید و هرگز در مخزن قرار ندهید.
PARSGREEN_API_KEY=
PARSGREEN_ADD_NAME=true
# این دو گزینه در محیط عملیاتی باید false باشند.
PARSGREEN_DRY_RUN=false
PARSGREEN_DEBUG=false
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_STEP_TOKEN_SECONDS=600
OTP_LENGTH=5
