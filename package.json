{
  "name": "mohammadiig-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "MIG Industrial Group workspace",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm --prefix backend run start:dev\" \"npm --prefix frontend run dev\"",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start",
    "start:frontend": "npm --prefix frontend run start"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
